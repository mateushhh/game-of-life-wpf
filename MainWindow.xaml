<Window x:Class="GameOfLife.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game of Life" 
        Width="1280" Height="720" 
        MinWidth="800" MinHeight="600" 
        Background="#F3F5F8" 
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="DarkGray"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="GhostWhite"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>


        <Style x:Key="GenerateButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="CornflowerBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF6495ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF5686D9"/>
                    <Setter Property="BorderBrush" Value="#FF4676C9"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF4169B1"/>
                    <Setter Property="BorderBrush" Value="#FF355899"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="GhostWhite"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <ControlTemplate x:Key="StatCardTemplate" TargetType="ContentControl">
            <Border Background="#FAFAFA" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12" 
                Margin="0,0,0,8">
                <ContentPresenter/>
            </Border>
        </ControlTemplate>

        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StartStopScale" 
                         Storyboard.TargetProperty="ScaleX" 
                         From="1.0" To="1.06" 
                         Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="StartStopScale" 
                         Storyboard.TargetProperty="ScaleY" 
                         From="1.0" To="1.06" 
                         Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>


        <Border Margin="12" 
                Background="White" 
                Grid.Column="0">
            <ScrollViewer x:Name="BoardScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="Both"
                          Background="White"
                          PreviewMouseWheel="BoardScrollViewer_PreviewMouseWheel">

                <Canvas x:Name="BoardCanvas"
                        Background="White"
                        MouseLeftButtonDown="Board_MouseLeftButtonDown"
                        MouseRightButtonDown="Board_MouseRightButtonDown"
                        ClipToBounds="False">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="BoardScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Canvas.LayoutTransform>
                </Canvas>
            </ScrollViewer>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="32"
                Padding="8"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel Width="150">
                <TextBlock x:Name="ZoomValueText"
                           Text="Zoom: 100%"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <Slider x:Name="ZoomSlider"
                        Minimum="20"
                        Maximum="400"
                        Value="100"
                        TickFrequency="10"
                        IsSnapToTickEnabled="False"
                        ValueChanged="ZoomSlider_ValueChanged"/>
            </StackPanel>
        </Border>


        <Border Width="300" 
                Grid.Column="1"
                HorizontalAlignment="Right"
                Background="White" 
                BorderBrush="LightGray" 
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="SIMULATION PARAMETERS" 
                                FontSize="12" 
                                FontWeight="Bold"
                                Margin="0,0,0,12"/>

                    <TextBlock Text="R {1, 2, 3, 4}" 
                                Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RTextBox" Text="2, 3" 
                                Style="{StaticResource FieldTextBox}"/>
                    <TextBlock Text="W {1, 2, 3, 4, 5, 6}" 
                                Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="WTextBox" Text="2, 3" 
                                Style="{StaticResource FieldTextBox}"/>
                    <TextBlock Text="B {2, 3}" 
                                Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="BTextBox" Text="2, 3" 
                                Style="{StaticResource FieldTextBox}"/>
                    <TextBlock Text="P {0, 1}" 
                                Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PTextBox" Text="1" 
                                Style="{StaticResource FieldTextBox}"/>
                    <TextBlock Text="Z {0, 1, 2, 3}" 
                                Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ZTextBox" Text="0, 1, 2, 3" 
                                Style="{StaticResource FieldTextBox}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="M" 
                                        Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MTextBox" Text="2" 
                                        Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="L" 
                                        Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LTextBox" Text="10" 
                                        Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="ApplyParametersButton"
                            Content="APPLY" 
                            Click="ApplyParametersButton_Click"
                            Style="{StaticResource SecondaryButton}"/>

                    <!-- -->
                    <Separator Margin="0,12,0,16" Background="LightGray"/>

                    <TextBlock Text="BOARD SIZE" 
                                FontSize="12" 
                                FontWeight="Bold"
                                Margin="0,0,0,12"/>

                    <Grid>
                        <TextBlock Text="WIDTH" 
                                    Style="{StaticResource FieldLabel}" 
                                    VerticalAlignment="Center"/>
                        <TextBlock x:Name="WidthValueText" 
                                    Text="30" 
                                    HorizontalAlignment="Right"
                                    FontWeight="Bold" 
                                    FontSize="12"/>
                    </Grid>
                    <Slider x:Name="WidthSlider" 
                            Minimum="10" 
                            Maximum="200" 
                            Value="30"
                            TickFrequency="10" 
                            IsSnapToTickEnabled="True"
                            ValueChanged="DimensionSlider_ValueChanged" 
                            Margin="0,0,0,12"/>

                    <Grid>
                        <TextBlock Text="HEIGHT" 
                                    Style="{StaticResource FieldLabel}" 
                                    VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeightValueText" 
                                    Text="30" 
                                    HorizontalAlignment="Right"
                                    FontWeight="Bold" 
                                    FontSize="12"/>
                    </Grid>

                    <Slider x:Name="HeightSlider" 
                            Minimum="10" 
                            Maximum="200" 
                            Value="30"
                            TickFrequency="10" 
                            IsSnapToTickEnabled="True"
                            ValueChanged="DimensionSlider_ValueChanged" 
                            Margin="0,0,0,12"/>

                    <Button Content="GENERATE"
                            x:Name="GenerateButton"
                            Click="GenerateButton_Click"
                            Style="{StaticResource GenerateButton}"/>

                    <!-- -->
                    <Separator Margin="0,12,0,16" Background="LightGray"/>

                    <TextBlock Text="CONTROLS" 
                                FontSize="12" 
                                FontWeight="Bold" 
                                Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="StartStopButton"
                                Content="START" 
                                Click="StartStopButton_Click"
                                Background="CornflowerBlue"
                                Foreground="White"
                                Height="32"
                                FontSize="12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                BorderBrush="#FF6495ED"
                                BorderThickness="1">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="StartStopScale" ScaleX="1" ScaleY="1"/>
                            </Button.RenderTransform>
                            <Button.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5"/>
                            </Button.RenderTransformOrigin>
                        </Button>

                        <Button Grid.Column="2" 
                                x:Name="StepButton"
                                Content="STEP" 
                                Click="StepButton_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="RandomizeButton"
                                Content="RANDOMIZE" 
                                Click="RandomizeButton_Click"
                                Style="{StaticResource SecondaryButton}"/>

                        <Button Grid.Column="2" 
                                x:Name="ClearButton"
                                Content="CLEAR" 
                                Click="ClearButton_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="SPEED" 
                                   Style="{StaticResource FieldLabel}" 
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="SpeedValueText" 
                                   Text="0" 
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold" 
                                   FontSize="12"/>
                    </Grid>

                    <Slider x:Name="SpeedSlider" 
                        Minimum="0" 
                        Maximum="10" 
                        Value="1"
                        TickFrequency="1" 
                        IsSnapToTickEnabled="True"
                        ValueChanged="SpeedSlider_ValueChanged" 
                        Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="SAVE" 
                                Click="SaveButton_Click"
                                Style="{StaticResource SecondaryButton}"/>

                        <Button Grid.Column="2" 
                                Content="LOAD" 
                                Click="LoadButton_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <!-- -->
                    <Separator Margin="0,12,0,16" Background="LightGray"/>

                    <TextBlock Text="STATISTICS" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ContentControl Template="{StaticResource StatCardTemplate}">
                        <StackPanel>
                            <TextBlock Text="Simulation Status" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TicksText" Text="Ticks: 0" Foreground="#333333"/>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Template="{StaticResource StatCardTemplate}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Plants" FontWeight="Bold" Foreground="Green" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AlivePText" Text="Alive: 0"/>
                                <TextBlock x:Name="BornPText" Text="Births: 0"/>
                                <TextBlock x:Name="DeathPText" Text="Deaths: 0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Animals" FontWeight="Bold" Foreground="Red" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AliveAText" Text="Alive: 0"/>
                                <TextBlock x:Name="BornAText" Text="Births: 0"/>
                                <TextBlock x:Name="DeathAText" Text="Deaths: 0"/>
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>

</Window>
